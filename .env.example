DEBUG=false
ONLY_ONE_LOG_FILE=false
LOG_DIR=./logs

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:32b
# openai-compatible 的 Endpoint 需要包含 /v1；ollama 会自动补全 /v1
LLM_ENDPOINT=http://localhost:11434/v1
LLM_API_KEY=
# 留空使用编译进二进制的默认 Prompt；设置目录后可不重新构建而独立迭代。
# 目录必须包含 system.md、default-instruction.md 和 manifest.json。
LLM_PROMPTS_DIR=prompts/toolops-agent/v3

# LLM Judge。正式评测建议使用与被测 Agent 不同且能力相当或更强的模型。
JUDGE_PROVIDER=openai-compatible
JUDGE_MODEL=
JUDGE_ENDPOINT=http://localhost:11434/v1
JUDGE_API_KEY=
JUDGE_PASS_THRESHOLD=0.8
JUDGE_TIMEOUT_SECONDS=120

# Agent 可观测性。接入 CozeLoop 时填写 Workspace 和 Token 后启用。
COZELOOP_ENABLED=false
# 开源版后端通常为 http://localhost:8888；留空则使用 SDK 默认地址。
COZELOOP_API_BASE_URL=http://localhost:8888
COZELOOP_WORKSPACE_ID=
COZELOOP_API_TOKEN=
COZELOOP_SERVICE_NAME=talon-toolops
COZELOOP_DEPLOYMENT_ENV=dev
COZELOOP_INPUT_OUTPUT_MAX_BYTES=4096
COZELOOP_NORMAL_MAX_BYTES=2048
COZELOOP_AGGREGATE_OUTPUT=true
